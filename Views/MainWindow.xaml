<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenWithTool.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OpenWithTool.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OpenWithTool.Models"
    Title="OpenWith Tool"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Subtitle="Browser selector"
            Title="OpenWith Tool">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="SettingsButton"
                    AutomationProperties.Name="Settings"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.OpenSettingsCommand}"
                    ToolTipService.ToolTip="Settings"
                    Visibility="{x:Bind local:MainWindow.BoolToVisibility(ViewModel.ShowSettingsButton), Mode=OneWay}">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <Grid
            x:Name="Root"
            Grid.Row="1"
            Margin="24,16,24,20"
            KeyDown="Root_KeyDown"
            PointerMoved="Root_PointerMoved">
            <Grid.Resources>
                <Style x:Key="BrowserListViewItemStyle" TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="68" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                    <Setter Property="Padding" Value="8,4" />
                    <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                </Style>
                <Style x:Key="ProfileGridViewItemStyle" TargetType="GridViewItem">
                    <Setter Property="Width" Value="128" />
                    <Setter Property="Height" Value="108" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0,0,8,8" />
                </Style>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="Choose where to open this link" />
                <Button
                    Grid.Column="1"
                    Padding="8,4"
                    AutomationProperties.AutomationId="RefreshButton"
                    AutomationProperties.Name="Refresh browser list"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    ToolTipService.ToolTip="Refresh browser list">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE72C;" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border
                Grid.Row="1"
                Margin="0,0,0,12"
                Padding="12,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        FontSize="16"
                        Glyph="&#xE71B;"
                        VerticalAlignment="Top" />
                    <TextBlock
                        Grid.Column="1"
                        AutomationProperties.AutomationId="UrlText"
                        FontFamily="Consolas"
                        FontSize="12"
                        Text="{x:Bind ViewModel.Url, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="WrapWholeWords" />
                </Grid>
            </Border>

            <InfoBar
                Grid.Row="2"
                Margin="0,0,0,8"
                AutomationProperties.AutomationId="AutoSelectInfoBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsTimerActive, Mode=OneWay}"
                Message="{x:Bind ViewModel.TimerMessage, Mode=OneWay}"
                Severity="Informational"
                Title="Auto-select active" />

            <ListView
                x:Name="BrowserList"
                Grid.Row="3"
                AutomationProperties.AutomationId="BrowserList"
                DoubleTapped="BrowserList_DoubleTapped"
                ItemContainerStyle="{StaticResource BrowserListViewItemStyle}"
                ItemsSource="{x:Bind ViewModel.Browsers, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedBrowser, Mode=TwoWay}"
                SelectionMode="Single"
                Visibility="{x:Bind local:MainWindow.InvertBoolToVisibility(ViewModel.IsBrowserFocused), Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:BrowserInfo">
                        <Grid MinHeight="56" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="192" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="40"
                                Height="40"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                <Grid>
                                    <FontIcon FontSize="20" Glyph="&#xE774;" />
                                    <Image
                                        Width="28"
                                        Height="28"
                                        Source="{x:Bind local:MainWindow.IconFromPath(IconCachePath), Mode=OneWay}"
                                        Stretch="Uniform" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind DisplayName, Mode=OneWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ExecutablePath, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <ComboBox
                                Grid.Column="2"
                                AutomationProperties.AutomationId="{x:Bind local:MainWindow.BrowserProfileAutomationId(Name), Mode=OneWay}"
                                AutomationProperties.Name="Browser profile"
                                DisplayMemberPath="Name"
                                ItemsSource="{x:Bind Profiles, Mode=OneWay}"
                                SelectedItem="{x:Bind SelectedProfile, Mode=TwoWay}"
                                ToolTipService.ToolTip="Choose a browser profile"
                                VerticalAlignment="Center" />

                            <Button
                                Grid.Column="3"
                                Width="40"
                                Height="40"
                                AutomationProperties.AutomationId="{x:Bind local:MainWindow.FocusButtonAutomationId(Name), Mode=OneWay}"
                                AutomationProperties.Name="Focus this browser"
                                Click="FocusBrowser_Click"
                                Tag="{x:Bind Mode=OneWay}"
                                ToolTipService.ToolTip="Focus this browser">
                                <FontIcon FontSize="16" Glyph="&#xE840;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid
                Grid.Row="3"
                Visibility="{x:Bind local:MainWindow.BoolToVisibility(ViewModel.IsBrowserFocused), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,16" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="48"
                        Height="48"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <Grid>
                            <FontIcon FontSize="22" Glyph="&#xE774;" />
                            <Image
                                Width="32"
                                Height="32"
                                Source="{x:Bind local:MainWindow.IconFromPath(ViewModel.FocusedBrowserIconPath), Mode=OneWay}"
                                Stretch="Uniform" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.FocusedBrowserDisplayName, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="Choose a profile" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        AutomationProperties.AutomationId="OtherBrowsersButton"
                        AutomationProperties.Name="Show other browsers"
                        Command="{x:Bind ViewModel.ShowOtherBrowsersCommand}"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE72B;" />
                            <TextBlock Text="Other browsers" />
                        </StackPanel>
                    </Button>
                </Grid>

                <GridView
                    x:Name="FocusedProfileGrid"
                    Grid.Row="2"
                    AutomationProperties.AutomationId="FocusedProfileGrid"
                    ItemContainerStyle="{StaticResource ProfileGridViewItemStyle}"
                    ItemsSource="{x:Bind ViewModel.FocusedProfiles, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.FocusedProfile, Mode=OneWay}"
                    SelectionChanged="FocusedProfileGrid_SelectionChanged"
                    SelectionMode="Single">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:BrowserProfile">
                            <Grid Padding="10">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                    <FontIcon FontSize="28" Glyph="&#xE77B;" />
                                    <TextBlock
                                        MaxWidth="100"
                                        Text="{x:Bind Name, Mode=OneWay}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>

            <Grid Grid.Row="4" Margin="0,12,0,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    AutomationProperties.AutomationId="RememberSelectionCheckBox"
                    Content="Remember for this site"
                    IsChecked="{x:Bind ViewModel.RememberSelection, Mode=TwoWay}"
                    VerticalAlignment="Center" />
                <ComboBox
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="SiteMatchComboBox"
                    DisplayMemberPath="DisplayText"
                    IsEnabled="{x:Bind ViewModel.RememberSelection, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.MatchOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedMatchOption, Mode=TwoWay}" />
                <Button
                    Grid.Column="2"
                    AutomationProperties.AutomationId="SitesButton"
                    AutomationProperties.Name="Remembered sites"
                    Command="{x:Bind ViewModel.OpenSitesSettingsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8EF;" />
                        <TextBlock Text="Sites" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="5" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    AutomationProperties.AutomationId="StatusText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button
                        Width="96"
                        AutomationProperties.AutomationId="CancelButton"
                        Command="{x:Bind ViewModel.CancelCommand}"
                        Content="Cancel" />
                    <Button
                        Width="104"
                        AutomationProperties.AutomationId="OpenButton"
                        AutomationProperties.Name="Open link"
                        Command="{x:Bind ViewModel.LaunchCommand}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                            <TextBlock Text="Open" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
