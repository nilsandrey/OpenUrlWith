<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenWithTool.Views.SitesSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OpenWithTool.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OpenWithTool.Models"
    Title="Remembered sites"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Subtitle="Browser rules"
            Title="Remembered sites">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid x:Name="Root" Grid.Row="1" Margin="24,12,24,20">
            <Grid.Resources>
                <Style x:Key="RuleListViewItemStyle" TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="44" />
                    <Setter Property="Padding" Value="12,8" />
                </Style>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Margin="0,0,0,12"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="Choose the browser and profile used for matching links" />

            <Grid
                Grid.Row="1"
                Margin="12,0,12,4"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="MATCH" />
                <TextBlock Grid.Column="1" Style="{ThemeResource CaptionTextBlockStyle}" Text="BROWSER" />
                <TextBlock Grid.Column="2" Style="{ThemeResource CaptionTextBlockStyle}" Text="PROFILE" />
            </Grid>

            <ListView
                Grid.Row="2"
                AutomationProperties.AutomationId="RememberedSitesList"
                ItemContainerStyle="{StaticResource RuleListViewItemStyle}"
                ItemsSource="{x:Bind ViewModel.Rules, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedRule, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:RememberedSiteRule">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Pattern, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind local:SitesSettingsWindow.MatchTypeName(MatchType), Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind BrowserDisplayName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="2"
                                Text="{x:Bind ProfileName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Expander
                Grid.Row="3"
                Margin="0,12,0,10"
                AutomationProperties.AutomationId="AddRuleExpander"
                Header="Add a remembered site"
                IsExpanded="True">
                <Grid Padding="4,12,4,4" ColumnSpacing="12" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.ColumnSpan="4"
                        AutomationProperties.AutomationId="NewRuleUrlTextBox"
                        Header="URL"
                        PlaceholderText="https://www.example.com/path"
                        Text="{x:Bind ViewModel.NewRuleUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <ComboBox
                        Grid.Row="1"
                        AutomationProperties.AutomationId="MatchTypeComboBox"
                        DisplayMemberPath="DisplayName"
                        Header="Match by"
                        ItemsSource="{x:Bind ViewModel.MatchTypes, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.NewRuleMatchType, Mode=TwoWay}" />

                    <ComboBox
                        Grid.Row="1"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="RuleBrowserComboBox"
                        DisplayMemberPath="DisplayName"
                        Header="Browser"
                        ItemsSource="{x:Bind ViewModel.Browsers, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.NewRuleBrowser, Mode=TwoWay}" />

                    <ComboBox
                        Grid.Row="1"
                        Grid.Column="2"
                        AutomationProperties.AutomationId="RuleProfileComboBox"
                        DisplayMemberPath="Name"
                        Header="Profile"
                        ItemsSource="{x:Bind ViewModel.NewRuleProfiles, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.NewRuleProfile, Mode=TwoWay}" />

                    <Button
                        Grid.Row="1"
                        Grid.Column="3"
                        MinWidth="88"
                        AutomationProperties.AutomationId="AddRuleButton"
                        Command="{x:Bind ViewModel.AddCommand}"
                        Content="Add"
                        Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Bottom" />
                </Grid>
            </Expander>

            <InfoBar
                Grid.Row="4"
                Margin="0,0,0,10"
                AutomationProperties.AutomationId="SitesStatusInfoBar"
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind local:SitesSettingsWindow.StatusSeverity(ViewModel.HasError), Mode=OneWay}" />

            <Grid Grid.Row="5">
                <Button
                    AutomationProperties.AutomationId="RemoveRuleButton"
                    Click="RemoveRule_Click"
                    IsEnabled="{x:Bind ViewModel.HasSelectedRule, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        <TextBlock Text="Remove" />
                    </StackPanel>
                </Button>
                <Button
                    Width="96"
                    HorizontalAlignment="Right"
                    AutomationProperties.AutomationId="CloseSitesButton"
                    Command="{x:Bind ViewModel.SaveAndCloseCommand}"
                    Content="Close"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
