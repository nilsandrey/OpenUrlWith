<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenWithTool.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OpenWithTool.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="OpenWith Tool settings"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Subtitle="Preferences"
            Title="Settings">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid x:Name="Root" Grid.Row="1" Margin="24,8,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer
                x:Name="SettingsScrollViewer"
                AutomationProperties.AutomationId="SettingsScrollViewer"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled">
                <StackPanel Spacing="8">
                    <TextBlock
                        Margin="0,0,0,2"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Text="Auto-selection" />

                    <controls:SettingsCard
                        Description="Open the last browser automatically when the countdown finishes."
                        Header="Enable auto-selection">
                        <ToggleSwitch
                            AutomationProperties.AutomationId="EnableAutoSelectToggle"
                            IsOn="{x:Bind ViewModel.EnableAutoSelect, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        Description="Time before the selected browser opens."
                        Header="Countdown">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Slider
                                Width="232"
                                AutomationProperties.AutomationId="AutoSelectTimeoutSlider"
                                IsEnabled="{x:Bind ViewModel.EnableAutoSelect, Mode=OneWay}"
                                Maximum="30"
                                Minimum="1"
                                StepFrequency="1"
                                Value="{x:Bind ViewModel.AutoSelectTimeoutSecondsValue, Mode=TwoWay}" />
                            <TextBlock
                                MinWidth="72"
                                Text="{x:Bind ViewModel.AutoSelectTimeoutSeconds, Mode=OneWay}"
                                TextAlignment="Right" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <TextBlock
                        Margin="0,8,0,2"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Text="Browser detection" />

                    <controls:SettingsCard
                        Description="Refresh browser and profile detection after this many hours."
                        Header="Cache duration">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Slider
                                Width="232"
                                AutomationProperties.AutomationId="CacheDurationSlider"
                                Maximum="168"
                                Minimum="1"
                                StepFrequency="1"
                                Value="{x:Bind ViewModel.CacheDurationHoursValue, Mode=TwoWay}" />
                            <TextBlock
                                MinWidth="72"
                                Text="{x:Bind ViewModel.CacheDurationHours, Mode=OneWay}"
                                TextAlignment="Right" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <TextBlock
                        Margin="0,8,0,2"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Text="Interface" />

                    <controls:SettingsCard
                        Description="Keep Settings available in the main command bar."
                        Header="Show Settings command">
                        <ToggleSwitch
                            AutomationProperties.AutomationId="ShowSettingsToggle"
                            IsOn="{x:Bind ViewModel.ShowSettingsButton, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <TextBlock
                        Margin="0,8,0,2"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Text="Windows registration" />

                    <InfoBar
                        AutomationProperties.AutomationId="RegistrationInfoBar"
                        IsClosable="False"
                        IsOpen="True"
                        Message="{x:Bind local:SettingsWindow.RegistrationMessage(ViewModel.IsRegisteredAsDefaultBrowser), Mode=OneWay}"
                        Severity="{x:Bind local:SettingsWindow.RegistrationSeverity(ViewModel.IsRegisteredAsDefaultBrowser), Mode=OneWay}"
                        Title="{x:Bind local:SettingsWindow.RegistrationTitle(ViewModel.IsRegisteredAsDefaultBrowser), Mode=OneWay}" />

                    <controls:SettingsCard
                        Description="Registration changes require an elevated process."
                        Header="Default browser registration">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                AutomationProperties.AutomationId="RegisterButton"
                                Command="{x:Bind ViewModel.RegisterBrowserCommand}"
                                Content="Register" />
                            <Button
                                AutomationProperties.AutomationId="UnregisterButton"
                                Command="{x:Bind ViewModel.UnregisterBrowserCommand}"
                                Content="Unregister" />
                            <Button
                                AutomationProperties.AutomationId="DefaultAppsButton"
                                Command="{x:Bind ViewModel.OpenDefaultAppsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE713;" />
                                    <TextBlock Text="Default apps" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </controls:SettingsCard>

                </StackPanel>
            </ScrollViewer>

            <TextBlock
                Grid.Row="1"
                Margin="0,6"
                AutomationProperties.AutomationId="SettingsStatusText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button
                    Width="96"
                    AutomationProperties.AutomationId="SettingsCancelButton"
                    Command="{x:Bind ViewModel.CancelCommand}"
                    Content="Cancel" />
                <Button
                    Width="96"
                    AutomationProperties.AutomationId="SettingsSaveButton"
                    Command="{x:Bind ViewModel.SaveCommand}"
                    Content="Save"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
